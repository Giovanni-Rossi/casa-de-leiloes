{
  "name": "leiloes-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed-cli.js",
    "test": "NODE_ENV=test DATABASE_URL=${TEST_DATABASE_URL:-postgres://leilao:leilao@localhost:5432/leilao_test} node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "NODE_ENV=test node --test \"test/unit/*.test.js\"",
    "test:coverage": "NODE_ENV=test DATABASE_URL=${TEST_DATABASE_URL:-postgres://leilao:leilao@localhost:5432/leilao_test} node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"src/index.js\" --test-coverage-exclude=\"src/seed-cli.js\" \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
